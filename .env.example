# Public Sanity values used by the browser content runtime.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_STUDIO_HOST=

# Sanity Studio uses these names locally. They are intentionally separate from
# the browser-facing values so a Studio token is never bundled into index.html.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional server-only preview values. Never expose the token in the static site.
SANITY_PREVIEW_TOKEN=
